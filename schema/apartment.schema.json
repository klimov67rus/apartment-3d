{
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "name": {
      "type": "string"
    },
    "units": {
      "enum": [
        "m",
        "px"
      ]
    },
    "scale": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "estimated"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "source"
      ],
      "additionalProperties": false
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "end": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "thickness": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "thickness",
          "height"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "polygon": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 3
          }
        },
        "required": [
          "id",
          "name",
          "polygon"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "wallId": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "door",
              "window"
            ]
          },
          "offset": {
            "type": "number",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bottom": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "wallId",
          "kind",
          "offset",
          "width",
          "bottom",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "modelId": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "rotation": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "modelId",
          "position",
          "rotation"
        ],
        "additionalProperties": false
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^/models/[a-zA-Z0-9_/-]+\\.glb$"
      }
    }
  },
  "required": [
    "version",
    "name",
    "units",
    "scale",
    "uncertainties",
    "walls",
    "rooms",
    "openings",
    "furniture",
    "models"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "units": {
            "const": "m"
          }
        }
      },
      "then": {
        "properties": {
          "scale": {
            "properties": {
              "status": {
                "enum": [
                  "known",
                  "estimated"
                ]
              }
            },
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "scale": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "type": "object"
          }
        }
      }
    }
  ]
}
